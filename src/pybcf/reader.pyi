from __future__ import annotations

from collections.abc import Iterator
from os import PathLike
from types import TracebackType
from typing import Any, BinaryIO, NoReturn, TextIO, TypeVar, overload

import numpy as np
from numpy.typing import NDArray

_T = TypeVar('_T')

InfoValue = (
    bool
    | int
    | float
    | str
    | tuple[int | None, ...]
    | tuple[float | None, ...]
    | tuple[str, ...]
    | None
)

SampleValue = NDArray[np.float64] | NDArray[np.float32] | list[tuple[str, ...]]

class BcfHeader:
    def __init__(self, *args: Any, **kwargs: Any) -> NoReturn: ...
    @property
    def samples(self) -> list[str]: ...
    @property
    def contigs(self) -> list[str]: ...
    @property
    def filters(self) -> list[str]: ...
    @property
    def formats(self) -> list[str]: ...
    @property
    def info(self) -> list[str]: ...

class BcfInfo:
    def __init__(self, *args: Any, **kwargs: Any) -> NoReturn: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[InfoValue]: ...
    def items(self) -> list[tuple[str, InfoValue]]: ...
    def __iter__(self) -> Iterator[str]: ...
    @overload
    def get(self, key: str, default: None = None) -> InfoValue: ...
    @overload
    def get(self, key: str, default: _T) -> InfoValue | _T: ...
    def __getitem__(self, key: str) -> InfoValue: ...

class BcfSampleData:
    def __init__(self, *args: Any, **kwargs: Any) -> NoReturn: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[SampleValue]: ...
    def items(self) -> list[tuple[str, SampleValue]]: ...
    def __iter__(self) -> Iterator[str]: ...
    @overload
    def get(self, key: str, default: None = None) -> SampleValue | None: ...
    @overload
    def get(self, key: str, default: _T) -> SampleValue | _T: ...
    def __getitem__(self, key: str) -> SampleValue: ...
    @property
    def phased(self) -> NDArray[np.bool_]: ...

class BcfVariant:
    def __init__(self, *args: Any, **kwargs: Any) -> NoReturn: ...
    @property
    def chrom(self) -> str: ...
    @property
    def contig(self) -> str: ...
    @property
    def pos(self) -> int: ...
    @property
    def ref(self) -> str: ...
    @property
    def alts(self) -> tuple[str, ...] | None: ...
    @property
    def id(self) -> str | None: ...
    @property
    def qual(self) -> float | None: ...
    @property
    def filter(self) -> list[str]: ...
    @property
    def info(self) -> BcfInfo: ...
    @property
    def samples(self) -> BcfSampleData: ...

class BcfReader:
    def __init__(
        self,
        path: str | PathLike[str] | TextIO | BinaryIO,
        index_path: str | PathLike[str] | None = None,
    ) -> None: ...
    def close(self) -> None: ...
    def __repr__(self) -> str: ...
    def __iter__(self) -> BcfReader: ...
    def __next__(self) -> BcfVariant: ...
    @property
    def header(self) -> BcfHeader: ...
    @property
    def samples(self) -> list[str]: ...
    def fetch(
        self,
        chrom: str,
        start: int | None = None,
        stop: int | None = None,
    ) -> BcfReader: ...
    def __enter__(self) -> BcfReader: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
